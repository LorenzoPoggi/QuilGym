# Postgres (Neon). Usar la URL "pooled" del proyecto.
DATABASE_URL=

# Solo en npm run dev. Vacío = simulador local activo; false = integraciones reales.
# Nunca se habilita en npm run build/start ni en producción.
CHECKOUT_DEMO_MODE=

# Configurar más adelante; no usar valores de ejemplo para cobrar.
# Verificar con `npm run checkout:check` qué medios quedan habilitados.
# Las variables NEXT_PUBLIC_* se fijan en el build: en Vercel hay que redeployar al cambiarlas.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Solo Preview protegido de Vercel: secreto de Protection Bypass for Automation.
# Nunca ponerlo en NEXT_PUBLIC_ ni compartirlo. En Preview, sin él MP queda deshabilitado.
# Vercel puede inyectar VERCEL_AUTOMATION_BYPASS_SECRET como variable de sistema tras configurarlo.
VERCEL_AUTOMATION_BYPASS_SECRET=
TRANSFER_ACCOUNT=
TRANSFER_HOLDER=
TRANSFER_TAX_ID=
PICKUP_ADDRESS=
PICKUP_HOURS=
CASH_PICKUP_ENABLED=

# JSON de tarifas aprobadas por el negocio. Vacío = envío no disponible.
# Estructura: [{"id":"zona","label":"...","postalCodes":["1878"],"priceArs":0,"estimate":"..."}]
SHIPPING_RATES_JSON=

# Emails (adaptador Resend). Sin estos valores, se conservan en la outbox.
RESEND_API_KEY=
EMAIL_FROM=

# Secreto de los crons de Vercel (/api/internal/order-emails y /api/internal/expire-orders).
# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>". Vacío = crons deshabilitados (401).
CRON_SECRET=

# Firma el link al pedido que va en el email y en la vuelta desde Mercado Pago (?t=...).
# Mínimo 32 caracteres. Generar con: openssl rand -base64 32
# Vacío = el pedido solo se ve desde el navegador que lo creó. Cambiarlo invalida los links ya enviados.
ORDER_ACCESS_SECRET=

# Horas hasta cancelar un pedido pendiente sin pago iniciado (libera stock y cupón). Default 72; rango 1–720.
PENDING_ORDER_TTL_HOURS=

# Cuentas (Better Auth). Desarrollo funciona localmente sin configurar Google.
# Producción requiere secreto aleatorio de 32+ caracteres y URL https.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback autorizado en Google Cloud: http://localhost:3000/api/auth/callback/google

# Vercel Blob (panel admin). Conectar un Blob Store público al proyecto Vercel;
# Vercel crea esta variable en Production. Para probar cargas en local, copiarla
# con `vercel env pull .env.local` o pegarla manualmente sin compartirla ni commitearla.
BLOB_READ_WRITE_TOKEN=

# Reseñas oficiales de Google Places (opcional, hasta 5). Solo servidor.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Asesor conversacional (Gemini directo), solo servidor. No usar NEXT_PUBLIC_.
# Crear la clave en Google AI Studio; revisar cuotas y facturación de su proyecto.
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_GATEWAY_API_KEY se acepta temporalmente como alias de una clave GOOGLE, no de Vercel.
# Opcional: identificador del modelo habilitado por la API de Google.
# Por defecto gemini-3.5-flash-lite (nivel gratuito y verificado por API el 5/10/2026).
ADVISOR_MODEL=
